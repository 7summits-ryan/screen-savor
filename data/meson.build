install_data(
  'software.sevensummits.screensavor.desktop.in',
  rename: 'software.sevensummits.screensavor.desktop',
  install_dir: join_paths(get_option('datadir'), 'applications')
)

install_data(
  'software.sevensummits.screensavor.metainfo.xml.in',
  rename: 'software.sevensummits.screensavor.metainfo.xml',
  install_dir: join_paths(get_option('datadir'), 'metainfo')
)

install_data(
  'software.sevensummits.screensavor.gschema.xml',
  install_dir: join_paths(get_option('datadir'), 'glib-2.0', 'schemas')
)

install_data(
  'software.sevensummits.screensavor.png',
  install_dir: join_paths(get_option('datadir'), 'icons', 'hicolor', '256x256', 'apps')
)
